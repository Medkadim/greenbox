// GreenBox — healthy meal subscription platform
// Prisma schema: see https://pris.ly/d/prisma-schema
//
// Operational model: the admin runs the whole platform. Customers have no
// login — the admin enters and maintains all of their data, including their
// weekly meal plan. Only ADMIN, KITCHEN_CHEF, and DELIVERY_DRIVER are
// authenticated roles.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth compatible schema: user / session / account / verification)
// ---------------------------------------------------------------------------

enum UserRole {
  PENDING // self-registered, not yet promoted by an admin
  KITCHEN_CHEF
  DELIVERY_DRIVER
  ADMIN
}

model User {
  id                  String   @id @default(cuid())
  name                String?
  email               String?  @unique
  emailVerified       Boolean  @default(false)
  phoneNumber         String?  @unique
  phoneNumberVerified Boolean  @default(false)
  image               String?
  role                UserRole @default(PENDING)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  driver   Driver?

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Customer — a plain record maintained by the admin, no login of its own
// ---------------------------------------------------------------------------

enum CustomerStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum PreferenceType {
  LIKE
  DISLIKE
  AVOID
}

enum CustomerTagType {
  NEW_CUSTOMER
  VIP
  ALLERGY_ALERT
  VEGETARIAN
  VEGAN
  HIGH_PROTEIN
  WEIGHT_LOSS
}

model CustomerProfile {
  id                     String         @id @default(cuid())
  firstName              String
  lastName               String
  phoneNumber            String         @unique
  status                 CustomerStatus @default(ACTIVE)
  address                String?
  latitude               Float?
  longitude              Float?
  preferredDeliveryStart String? // e.g. "12:00"
  preferredDeliveryEnd   String? // e.g. "14:00"
  suggestions            String?
  otherAllergies         String? // free text, for allergies not in the Allergy reference list
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  preferences    CustomerPreference[]
  allergies      CustomerAllergy[]
  tags           CustomerProfileTag[]
  mealSelections CustomerMealSelection[]
  deliveries     Delivery[]

  @@map("customer_profile")
}

// General food preferences, distinct from allergies and meal-specific requests.
model CustomerPreference {
  id        String         @id @default(cuid())
  type      PreferenceType
  label     String // e.g. "spicy food", "vegetables", "onions"
  createdAt DateTime       @default(now())

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@map("customer_preference")
}

model Allergy {
  id   String @id @default(cuid())
  name String @unique // Nuts, Lactose, Gluten, ...

  customers CustomerAllergy[]

  @@map("allergy")
}

model CustomerAllergy {
  id    String  @id @default(cuid())
  notes String?

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  allergyId         String
  allergy           Allergy         @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  @@unique([customerProfileId, allergyId])
  @@map("customer_allergy")
}

model CustomerProfileTag {
  id         String          @id @default(cuid())
  tag        CustomerTagType
  assignedAt DateTime        @default(now())

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@unique([customerProfileId, tag])
  @@map("customer_profile_tag")
}

// ---------------------------------------------------------------------------
// Meals & recipes
// ---------------------------------------------------------------------------

model Meal {
  id          String   @id @default(cuid())
  name        String
  description String?
  photoUrl    String?
  category    String? // e.g. Bowl, Salad, Soup
  calories    Int?
  protein     Float?
  carbs       Float?
  fat         Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipe     Recipe?
  selections CustomerMealSelection[]

  @@map("meal")
}

model Ingredient {
  id   String @id @default(cuid())
  name String @unique
  unit String // kg, liter, piece, ...

  recipeIngredients RecipeIngredient[]

  @@map("ingredient")
}

model Recipe {
  id           String  @id @default(cuid())
  instructions String?

  mealId String @unique
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  ingredients RecipeIngredient[]

  @@map("recipe")
}

model RecipeIngredient {
  id       String @id @default(cuid())
  quantity Float
  unit     String

  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredient")
}

// ---------------------------------------------------------------------------
// Weekly meal planning — the admin assigns each customer a meal per
// day/slot for a given week (re-entered week to week, no self-service).
// ---------------------------------------------------------------------------

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

model CustomerMealSelection {
  id            String    @id @default(cuid())
  weekStartDate DateTime // Monday of the target week, normalized to midnight
  dayOfWeek     DayOfWeek
  mealSlot      MealSlot
  note          String? // meal-specific remark, e.g. "no onions", set by the admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  mealId            String
  meal              Meal            @relation(fields: [mealId], references: [id])

  delivery Delivery?

  @@unique([customerProfileId, weekStartDate, dayOfWeek, mealSlot])
  @@map("customer_meal_selection")
}

// ---------------------------------------------------------------------------
// Delivery
// ---------------------------------------------------------------------------

enum DeliveryStatus {
  PENDING
  PREPARING
  READY
  ON_THE_WAY
  DELIVERED
  FAILED
}

model Driver {
  id          String   @id @default(cuid())
  vehicleInfo String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveries Delivery[]

  @@map("driver")
}

model Delivery {
  id                 String         @id @default(cuid())
  scheduledDate      DateTime
  mealSlot           MealSlot
  status             DeliveryStatus @default(PENDING)
  addressSnapshot    String
  latitude           Float?
  longitude          Float?
  preferredTimeStart String?
  preferredTimeEnd   String?
  deliveredAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  customerMealSelectionId String                @unique
  customerMealSelection   CustomerMealSelection @relation(fields: [customerMealSelectionId], references: [id], onDelete: Cascade)
  customerProfileId       String
  customerProfile         CustomerProfile       @relation(fields: [customerProfileId], references: [id])
  driverId                String?
  driver                  Driver?               @relation(fields: [driverId], references: [id])

  @@map("delivery")
}
